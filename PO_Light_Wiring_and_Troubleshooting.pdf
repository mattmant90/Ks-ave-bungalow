<text class="ts" x="344" y="222" text-anchor="middle">term 11 (strapped)</text>
<line class="wire" x1="362" y1="180" x2="600" y2="180"/>

<line class="wire" x1="60" y1="280" x2="130" y2="280"/>
<line class="sym" x1="130" y1="268" x2="130" y2="292"/>
<line class="sym" x1="156" y1="268" x2="156" y2="292"/>
