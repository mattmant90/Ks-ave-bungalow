<line class="sym" x1="150" y1="122" x2="176" y2="98"/>
<text class="ts" x="163" y="140" text-anchor="middle">XPR 21 (NC)</text>
<text class="ts" x="163" y="152" text-anchor="middle">relaxed = closed</text>

<line class="wire" x1="176" y1="110" x2="260" y2="110"/>
<circle cx="260" cy="110" r="2.5" fill="var(--text)"/>
<line class="wire" x1="260" y1="110" x2="260" y2="180"/>

<line class="wire" x1="260" y1="110" x2="320" y2="110"/>
<circle class="symfill" cx="344" cy="110" r="18"/>
<path class="sym" d="M334,104 q5,-6 10,0 q5,6 10,0" fill="none"/>
<text class="ts" x="344" y="140" text-anchor="middle">1-POR coil</text>
<text class="ts" x="344" y="152" text-anchor="middle">term 11</text>
<line class="wire" x1="362" y1="110" x2="600" y2="110"/>

<line class="wire" x1="260" y1="180" x2="320" y2="180"/>
<circle class="symfill" cx="344" cy="180" r="18"/>
<path class="sym" d="M334,174 q5,-6 10,0 q5,6 10,0" fill="none"/>
