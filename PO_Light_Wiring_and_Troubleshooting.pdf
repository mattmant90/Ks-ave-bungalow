<line class="wire" x1="156" y1="280" x2="200" y2="280"/>
<line class="sym" x1="200" y1="268" x2="200" y2="292"/>
<line class="sym" x1="226" y1="268" x2="226" y2="292"/>
<text class="ts" x="213" y="308" text-anchor="middle">2-POR 5 (NO)</text>

<line class="wire" x1="226" y1="280" x2="300" y2="280"/>
<text class="tsAmber" x="300" y="270" text-anchor="middle">POK wire</text>

<rect x="340" y="272" width="16" height="16" fill="none" class="sym"/>
<line class="sym" x1="340" y1="272" x2="356" y2="288"/>
<text class="ts" x="348" y="308" text-anchor="middle">WAGO 20+</text>
<line class="wire" x1="300" y1="280" x2="340" y2="280"/>

<line class="wire" x1="356" y1="280" x2="410" y2="280"/>
<circle class="symfill" cx="432" cy="280" r="16"/>
<line class="sym" x1="424" y1="272" x2="440" y2="288"/>
<line class="sym" x1="440" y1="272" x2="424" y2="288"/>
<text class="th" x="432" y="308" text-anchor="middle">PO LAMP</text>
<line class="wire" x1="448" y1="280" x2="600" y2="280"/>
</svg>

<!-- ============ SHEET 2 ============ -->
